{
  "expo": {
    "name": "BudgetIQ",
    "slug": "budgetiq",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asep08",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.name.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F8F7F4"
      },
      "package": "com.name.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c2f7e3f-0386-44df-9b19-29872563e6d2"
      }
    }
  }
}
